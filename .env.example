# DarkChecker — exemplo de configuração
# Copie este arquivo para `.env` e preencha conforme necessário.
# A aplicação FUNCIONA SEM NENHUMA chave: fontes gratuitas + modo demonstração.

# ---------------------------------------------------------------------------
# Have I Been Pwned (HIBP) — verificação de e-mail em vazamentos.
# A consulta de e-mail no HIBP exige assinatura paga (chave de API).
# É OPCIONAL. Sem ela, a app usa a fonte gratuita (XposedOrNot) + modo demo.
# Obtenha em: https://haveibeenpwned.com/API/Key
# ---------------------------------------------------------------------------
HIBP_API_KEY=

# User-Agent exigido pela API do HIBP (identifique sua aplicação).
HIBP_USER_AGENT=DarkChecker-Academic-Project

# ---------------------------------------------------------------------------
# Fontes gratuitas de e-mail (sem chave). Ativas por padrão; defina como
# `false` para desativar caso a API externa fique instável.
# ---------------------------------------------------------------------------
XPOSEDORNOT_ENABLED=true
LEAKCHECK_ENABLED=true

# ---------------------------------------------------------------------------
# Modo demonstração: quando `true`, se as APIs externas estiverem
# indisponíveis (offline, rate limit) a app devolve dados de exemplo
# claramente rotulados como fictícios. Útil para apresentação em sala.
# ---------------------------------------------------------------------------
DEMO_FALLBACK=true

# Timeout (segundos) para chamadas às APIs externas.
HTTP_TIMEOUT=10
